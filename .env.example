# =========================================================
# Vercel & Supabase Environment Variables
# Copy these into your Vercel Project Settings -> Environment Variables
# =========================================================

# 1. Supabase Public Credentials (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Supabase Private Service Role Key (Required - Server Only)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Application URL (Set this to your Vercel production domain, e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 4. Google Drive OAuth Credentials (For Admin Video Verification & Streaming)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 5. Optional Override for Google Redirect URI
# If not set, automatically resolves to https://<your-domain>/api/google/callback
# NOTE: Make sure to add https://<your-domain>/api/google/callback to "Authorized redirect URIs" in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/google/callback
